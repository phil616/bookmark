
main:
  push:
    - name: phil616-bookmark
      docker:
        image: node:24

      lock:
        key: phil616-bookmark
        wait: true
        cancel-in-progress: true
        cancel-in-wait: true
        expires: 1800
        timeout: 1800

      stages:
        - name: build frontend ci
          timeout: 15m
          script: |
            set -eu
            cd frontend
            npm ci --no-audit --no-fund

        - name: build frontend dist
          timeout: 20m
          script: |
            set -eu
            cd web
            export VITE_API_BASE_URL=https://bookmark-api.altasci.com
            npm run build

        - name: push to EdgeOne Pages
          image: node:20
          timeout: 15m
          imports:
            - https://cnb.cool/greenshadecapital/dreamreflex/assets-secrets/-/blob/main/api-server.yml
          script: |
            set -eu
            npx --yes edgeone pages deploy ./web/dist/ \
              -n phil616-bookmark \
              -t "${EDGEONE_API_TOKEN}"
