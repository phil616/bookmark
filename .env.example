# Docker Compose 使用；Go 程序本身只读取进程环境变量
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_KEY=replace-with-a-long-random-admin-key
# 前端（静态站点）端口
PORT=8080
# 后端 API 端口，浏览器直接访问它
API_PORT=8081
# 构建前端时写入的 API 地址，需与 API_PORT 对应；公网部署改成 https 地址
VITE_API_BASE_URL=http://localhost:8081
# 浏览器访问前端时的来源，必须与前端地址一致
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
# For PostgreSQL, start with --profile postgres and set:
DATABASE_URL=postgres://bookmarks:bookmarks-local-development@postgres:5432/bookmarks?sslmode=disable
# POSTGRES_PASSWORD=bookmarks-local-development
